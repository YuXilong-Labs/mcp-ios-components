# MCP iOS Components 环境变量配置
# 复制此文件为 .env 并填写实际值

# ========== 基础配置 ==========
# 服务端口
MCP_PORT=8900

# 组件更新检查间隔（秒），0 表示禁用
WATCH_INTERVAL=300

# 业务组件过滤标记
MIXUP_MARKER=SUPPORT_MIXUP

# ========== 数据目录 ==========
# 组件仓库存储路径
PODS_DATA_DIR=./data/pods

# 索引缓存目录
CACHE_DATA_DIR=./data/cache

# API 密钥存储目录
KEYS_DATA_DIR=./data/keys

# 组件配置文件路径
COMPONENTS_YAML=./components.yaml

# ========== GitLab 配置 ==========
# GitLab 服务器地址
GITLAB_URL=https://gitlab.your-company.com

# GitLab API Token（需要 read_api 权限）
# 创建：Settings → Access Tokens → 选择 read_api scope
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 要同步的 GitLab Group（可选）
GITLAB_GROUP=ios-components

# ========== SSH 配置 ==========
# SSH 私钥路径（用于 git clone）
SSH_KEY_PATH=~/.ssh/id_rsa

# ========== 安全配置 ==========
# Webhook 签名验证密钥
# 用于验证 GitLab/GitHub Webhook 请求
WEBHOOK_SECRET=your-random-secret-string-here

# ========== SSL 配置（启用 nginx profile 时需要）==========
# SSL 证书路径
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem
